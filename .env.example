# Database
SQLALCHEMY_DATABASE_URI=postgresql://postgres:your_password@localhost:5432/revoshop_db

# JWT secret key for token signing (generate with: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET_KEY=your-secret-key-here


# Google OAuth (optional, for social login)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# SMTP for email verification (optional)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
# Base URL for email confirmation links
BASE_URL=your-localhost-url:port

# Store configuration
TAX_PERCENT=11
CURRENCY=IDR

# Password for seeded demo accounts
SEED_PASSWORD=your-seed-password
