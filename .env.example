# Database
SQLALCHEMY_DATABASE_URI=postgresql://postgres:your_password@localhost:5432/revoshop_db

# JWT secret key for token signing (generate with: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET_KEY=your-secret-key-here


# Google OAuth (optional, for social login)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# SMTP for email verification (optional)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
# Base URL for email confirmation links
BASE_URL=your-localhost-url:port

# Store configuration
TAX_PERCENT=11
CURRENCY=IDR

# Midtrans payment gateway (get keys from dashboard -> Settings -> Access Keys)
# Use Sandbox keys (SB-Mid-...) for development. Set MIDTRANS_IS_PRODUCTION=true for live keys.
MIDTRANS_SERVER_KEY=SB-Mid-server-your-server-key
MIDTRANS_CLIENT_KEY=SB-Mid-client-your-client-key
MIDTRANS_IS_PRODUCTION=false

# Password for seeded demo accounts
SEED_PASSWORD=your-seed-password

# Environment: local | development | production
# local       -> DEBUG logs to console, no file
# development -> INFO+ console + ERROR-only rotating daily file (logs/error.log)
# production  -> WARNING+ console + ERROR-only rotating daily file (logs/error.log)
FLASK_ENV=local

# Optional logging overrides
# LOG_LEVEL=DEBUG        # force a specific console level, overrides FLASK_ENV
# LOG_DIR=logs           # where error.log is written (dev/prod)
# LOG_BACKUP_DAYS=365    # how many days of rotated error logs to keep